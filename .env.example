# ════════════════════════════════════════════════════
# Bikfayah Baptist Church — Environment Variables
# ════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ── Sanity CMS ───────────────────────────────────────
# Get these from https://sanity.io → your project → Settings → API
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your_sanity_api_token_here
# Optional: for preview drafts
SANITY_PREVIEW_SECRET=your_preview_secret_here

# ── Email (Resend) ────────────────────────────────────
# Sign up at https://resend.com — free tier works for small churches
RESEND_API_KEY=re_your_resend_api_key_here
CONTACT_EMAIL=info@bikfayabaptist.org
PASTOR_EMAIL=pastor@bikfayabaptist.org
PRAYER_TEAM_EMAIL=prayer@bikfayabaptist.org

# ── App ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://bikfayabaptist.org
NODE_ENV=development
